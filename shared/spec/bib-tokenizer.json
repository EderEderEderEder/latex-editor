            "text": "\""
          },
          {
            "kind": "delimiter",
            "text": "}"
          },
          {
            "kind": "command",
            "text": "@misc"
          },
          {
            "kind": "delimiter",
            "text": "("
          },
          {
            "kind": "keyArgument",
            "text": "x1"
          },
          {
            "kind": "optionalArgument",
            "text": "month"
          },
          {
            "kind": "delimiter",
            "text": "="
          },
          {
            "kind": "keyArgument",
            "text": "jan"
          },
          {
            "kind": "delimiter",
            "text": "#"
          },
          {
            "kind": "delimiter",
            "text": "\""
          },
          {
            "kind": "delimiter",
            "text": "\""
          },
          {
            "kind": "optionalArgument",
            "text": "note"
          },
          {
            "kind": "delimiter",
            "text": "="
          },
          {
            "kind": "delimiter",
            "text": "\""
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "delimiter",
            "text": "}"
          },
          {
            "kind": "delimiter",
            "text": "\""
          },
          {
            "kind": "delimiter",
            "text": ")"
          }
        ]
      }
    },
    {
      "id": "commentsOutsideEntries",
      "name": "Text außerhalb von Einträgen und @comment sind Kommentar, auch mit verschachtelten Klammern",
      "sourceLine": 68,
      "input": {
        "op": "highlightAll",
        "language": "bibtex",
        "source": "% Literatur\nFreier Text\n@comment{ein {Kommentar} hier}\n@book{a,}",
        "visibleOnly": true
      },
      "expect": {
        "tokensPrefix": [
          {
            "kind": "comment",
            "text": "% Literatur"
          },
          {
            "kind": "comment",
            "text": "Freier Text"
          },
          {
            "kind": "command",
            "text": "@comment"
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "comment",
            "text": "ein {Kommentar} hier"
          }
        ],
        "tokensSuffix": [
          {
            "kind": "command",
            "text": "@book"
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "keyArgument",
            "text": "a"
          },
          {
            "kind": "delimiter",
            "text": "}"
          }
        ]
      }
    },
    {
      "id": "percentComments",
      "name": "% bis zum Zeilenende ist Kommentar: auskommentierte Einträge und Felder; im Wert bleibt es Text",
      "sourceLine": 81,
      "input": {
        "op": "highlightAll",
        "language": "bibtex",
        "source": "% @book{alt,\n%   title = {Alt},\n% }\n@book{neu, % Schlüssel\n\t% note = {weg},\n\ttitle = {50 % und \\% hier},\n}",
        "visibleOnly": true
      },
      "expect": {
        "tokens": [
          {
            "kind": "comment",
            "text": "% @book{alt,"
          },
          {
            "kind": "comment",
            "text": "%   title = {Alt},"
          },
          {
            "kind": "comment",
            "text": "% }"
          },
          {
            "kind": "command",
            "text": "@book"
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "keyArgument",
            "text": "neu"
          },
          {
            "kind": "comment",
            "text": "% Schlüssel"
          },
          {
            "kind": "comment",
            "text": "% note = {weg},"
          },
          {
            "kind": "optionalArgument",
            "text": "title"
          },
          {
            "kind": "delimiter",
            "text": "="
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "command",
            "text": "\\%"
          },
          {
            "kind": "delimiter",
            "text": "}"
          },
          {
            "kind": "delimiter",
            "text": "}"
          }
        ]
      }
    },
    {
      "id": "multilineValue",
      "name": "Mehrzeilige Werte: Der Zustand trägt Klammertiefe und Phase in die nächste Zeile",
      "sourceLine": 102,
      "input": {
        "op": "highlightAll",
        "language": "bibtex",
        "source": "@article{k,\n  title = {Ein langer\n  Titel mit {Klammer}\n  über drei Zeilen},\n  year = {2024}\n}",
        "visibleOnly": true
      },
      "expect": {
        "endStatesPartial": {
          "1": {
            "bibtex": {
              "phase": "value",
              "depth": 2
            }
          }
        },
        "endStates": {
          "5": {
            "bibtex": {
              "phase": "outside",
              "kind": "regular",
              "depth": 0,
              "inQuotes": false,
              "closesWithParenthesis": false
            }
          }
        },
        "tokensNoneContainText": [
          "Titel",
          "Zeilen"
        ],
        "tokensContain": [
          {
            "kind": "optionalArgument",
            "text": "year"
          }
        ]
      }
    },
    {
      "id": "brokenEntryRecovers",
      "name": "Kaputter Eintrag (offenes Anführungszeichen) endet an der Eintragsklammer, der nächste wird erkannt",
      "sourceLine": 120,
      "input": {
        "op": "highlightAll",
        "language": "bibtex",
        "source": "@book{a, title = \"offen}\n@book{b, year = 1}",
        "visibleOnly": true
      },
      "expect": {
        "tokensContain": [
          {
            "kind": "keyArgument",
            "text": "b"
          },
          {
            "kind": "optionalArgument",
            "text": "year"
          }
        ]
      }
    },
    {
      "id": "languageFromExtension-bib",
      "name": "Sprache nach Endung; .tex bleibt LaTeX",
      "sourceLine": 153,
      "input": {
        "op": "languageFromPath",
        "path": "/p/hgbreferences.bib"
      },
      "expect": {
        "language": "bibtex"
      }
    },
