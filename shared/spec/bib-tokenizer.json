{
  "suite": "bib-tokenizer",
  "version": 1,
  "source": "swift/Tests/LatexEditorTests/BibTokenizerTests.swift",
  "notes": "Zeilenindizes in endStates und endStatesPartial sind 0-basiert. Die Fälle percentComments und multilineValue enthalten Nicht-ASCII (Umlaute), Erwartungen enthalten aber keine Offsets. Eingabetext heißt hier source (nicht text) und steckt im Fall unter input.source.",
  "skipped": [
    {
      "name": "Zufällige Bearbeitungen: inkrementell gleich komplett neu berechnet",
      "reason": "Zufall (SeededGenerator, Int.random), Vergleich gegen Neuaufbau statt Literal",
      "sourceLine": 128
    },
    {
      "name": "Eine .bib-Sitzung färbt Feldnamen; nach Umbenennen in .tex gelten die LaTeX-Farben",
      "reason": "AppKit (DocumentSession, NSColor, Textattribute), keine reine Tokenizer-Logik",
      "sourceLine": 164
    }
  ],
  "cases": [
    {
      "id": "typicalEntry",
      "name": "Typischer Eintrag: Typ, Schlüssel, Feldnamen, Klammern, Befehl im Wert; Werte und Zahlen bleiben Text",
      "sourceLine": 32,
      "input": {
        "op": "highlightAll",
        "language": "bibtex",
        "source": "@book{knuth1984,\n\tauthor = {Knuth, Donald},\n\ttitle = {The {\\TeX}book},\n\tyear = 1984,\n}",
        "visibleOnly": true
      },
      "expect": {
        "tokens": [
          {
            "kind": "command",
            "text": "@book"
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "keyArgument",
            "text": "knuth1984"
          },
          {
            "kind": "optionalArgument",
            "text": "author"
          },
          {
            "kind": "delimiter",
            "text": "="
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "delimiter",
            "text": "}"
          },
          {
            "kind": "optionalArgument",
            "text": "title"
          },
          {
            "kind": "delimiter",
            "text": "="
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "delimiter",
            "text": "{"
          },
          {
            "kind": "command",
            "text": "\\TeX"
          },
          {
            "kind": "delimiter",
            "text": "}"
          },
          {
            "kind": "delimiter",
            "text": "}"
          },
          {
            "kind": "optionalArgument",
            "text": "year"
          },
          {
            "kind": "delimiter",
            "text": "="
          },
          {
            "kind": "delimiter",
            "text": "}"
          }
        ]
      }
    },
    {
      "id": "quotesAndMacros",
      "name": "Anführungszeichen, Verkettung mit #, @string-Makro und runde Eintragsklammern",
      "sourceLine": 51,
      "input": {
        "op": "highlightAll",
        "language": "bibtex",
        "source": "@string{jan = \"Januar\"}\n@misc(x1, month = jan # \" 2024\", note = \"a {b} c\")",
        "visibleOnly": true
      },
      "expect": {
        "tokens": [
          {
            "kind": "command",
            "text": "@string"
          },
          {
            "kind": "delimiter",
