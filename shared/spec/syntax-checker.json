  "cases": [
    {
      "id": "cleanText",
      "name": "Korrekter Text hat keine Markierung",
      "sourceLine": 15,
      "input": {
        "text": "\\begin{document}\n\\section{Titel}\nEin $x^2$ und \\(y\\) sowie \\[ z \\] und $$a$$.\n\\begin{itemize}\\item \\{ok\\}\\end{itemize}\n\\end{document}\n"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "braces",
      "name": "Überzählige und fehlende Klammern",
      "sourceLine": 21,
      "input": {
        "text": "\\textbf{a}}\n\\emph{b\n"
      },
      "expect": {
        "count": 2,
        "allSeverity": "error",
        "firstLocation": 10,
        "foundTexts": [
          "{b"
        ]
      }
    },
    {
      "id": "ignoredBraces",
      "name": "Maskierte Klammern, Kommentare und Code zählen nicht",
      "sourceLine": 31,
      "input": {
        "text": "\\{ \\} % { offen\n\\begin{verbatim}\n{ } }\n\\end{verbatim}\n\\verb|{|\n"
      },
      "expect": {
        "count": 0
      }
    },
    {
      "id": "environments-unclosed",
      "name": "Umgebung ohne Ende, Ende ohne Anfang, falsch verschachtelt",
      "sourceLine": 37,
      "input": {
        "text": "\\begin{figure}\nx\n"
      },
      "expect": {
        "foundTexts": [
          "\\begin{figure}"
        ]
      }
    },
    {
      "id": "environments-orphanEnd",
      "name": "Umgebung ohne Ende, Ende ohne Anfang, falsch verschachtelt",
      "sourceLine": 37,
      "input": {
        "text": "x\\end{table}"
      },
      "expect": {
        "foundTexts": [
          "\\end{table}"
        ]
      }
    },
    {
      "id": "environments-nested",
      "name": "Umgebung ohne Ende, Ende ohne Anfang, falsch verschachtelt",
      "sourceLine": 37,
      "input": {
        "text": "\\begin{a}\\begin{b}\\end{a}"
      },
      "expect": {
        "count": 1,
        "foundTexts": [
          "\\begin{b}"
        ],
        "firstMessageContains": "Zeile 1"
      }
    },
    {
      "id": "definitions",
      "name": "Definitionen dürfen ein einzelnes \\begin oder \\end enthalten",
      "sourceLine": 48,
      "input": {
        "text": "\\newenvironment{box}{\\begin{center}}{\\end{center}}\n\\newcommand{\\bi}{\\begin{itemize}}\n\\def\\x{\\end{x}}\n"
      },
      "expect": {
        "count": 0
      }
    },
    {
