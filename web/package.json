{
    "name": "latexeditor-web",
    "version": "0.1.0",
    "private": true,
    "description": "LatexEditor Web: Electron-Version des lokalen LaTeX-Editors",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "test": "node scripts/test-run.mjs",
        "test:fast": "node scripts/test-run.mjs --fast",
        "test:e2e": "node scripts/test-run.mjs --e2e",
        "test:raw": "vitest run",
        "build:e2e": "RENDERER_VITE_EDITOR_TEST_API=1 electron-vite build",
        "package": "electron-vite build && electron-builder"
    },
    "dependencies": {
        "@codemirror/autocomplete": "6.20.4",
        "@codemirror/commands": "6.11.1",
        "@codemirror/language": "6.13.1",
        "@codemirror/lint": "6.9.8",
        "@codemirror/search": "6.7.2",
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.15",
        "@lezer/highlight": "1.2.5",
        "pdfjs-dist": "6.5.438",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "zustand": "5.1.0"
    },
    "devDependencies": {
        "@playwright/test": "1.65.1",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "ajv": "8.20.0",
        "electron": "45.4.1",
        "electron-builder": "26.18.0",
        "electron-vite": "6.0.0",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "4.1.12"
    }
}
