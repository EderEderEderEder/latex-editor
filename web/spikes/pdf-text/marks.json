    { "id": "t08", "doc": "test", "category": "mehrzeilig", "start": { "file": "s2test.tex", "line": 21 }, "end": { "file": "s2test.tex", "line": 23 }, "text": "Zeilenumbruch mitten im Satz geschieht und eine Markierung über mehrere Zeilen reichen muss. Die Wörter am Ende einer Zeile und am Anfang der nächsten Zeile sind dabei besonders interessant, weil die Textebene von pdf.js dort Zeilenenden einfügt und die Lage der Zeichen" },
    { "id": "t09", "doc": "test", "category": "Fließtext", "start": { "file": "s2test.tex", "line": 22 }, "end": { "file": "s2test.tex", "line": 22 }, "text": "Ende einer Zeile und am Anfang der nächsten" },
