    { "id": "t12", "doc": "test", "category": "Mathe im Text", "start": { "file": "s2test.tex", "line": 28 }, "end": { "file": "s2test.tex", "line": 28 }, "text": "gilt f (x) = x2 + 2x + 1, also ist die Funktion" },
